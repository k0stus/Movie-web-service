    (Register) as UC1
    (Login) as UC2
    (Browse Movies) as UC3
    (View Movie Details) as UC4
    (Play Movie / Trailer) as UC5
    (Rate Movie) as UC6
    (Comment Movie) as UC7
    (Add to Watch Later) as UC8
    (View Recommendations) as UC9
    (View User Statistics) as UC10
    (Manage Movies) as UC11
    (Generate Recommendations) as UC12
}

U --> UC1
U --> UC2
U --> UC3
U --> UC4
U --> UC5
U --> UC6
U --> UC7
U --> UC8
U --> UC9
U --> UC10
